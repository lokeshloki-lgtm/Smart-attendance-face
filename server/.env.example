PORT=10000
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_long_random_secret
GROQ_API_KEY=replace_with_your_groq_api_key
CLIENT_URL=https://smart-attendance-face-one.vercel.app
NODE_ENV=production
# face-api.js 128D descriptors use Euclidean distance; lower distance is a better match.
FACE_DISTANCE_THRESHOLD=0.45
FACE_DUPLICATE_THRESHOLD=0.45
FACE_DETECTION_THRESHOLD=0.5
ATTENDANCE_LOCATION_LAT=
ATTENDANCE_LOCATION_LNG=
ATTENDANCE_RADIUS_METERS=150
ATTENDANCE_LATE_TIME=09:00
ATTENDANCE_CLOSING_TIME=18:00
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-real-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=SmartAttend <your-real-email@gmail.com>
